# Copy to .env and fill in real values. Never commit .env.
# See docs/ARCHITECTURE.md §3.1 for what each variable does.
#
# Fitme itself only reads real environment variables (A§1): it does not load this file.
# Load it yourself:
#   - production (systemd): EnvironmentFile=/path/to/.env in the unit (see deploy/).
#   - dev: uv run --env-file .env fitme ...  (the Makefile's $(FITME) does this automatically
#     when a .env file is present in the repo root).

# --- Required ---

FITME_TELEGRAM_BOT_TOKEN=changeme
FITME_DB_PATH=./fitme.db
FITME_WEB_BASE_URL=https://fit.example.org
# At least 32 chars; the placeholder is deliberately too short so an unedited copy fails.
# Generate one: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
FITME_SECRET_KEY=changeme

# Read directly by pydantic-ai, not by fitme's own settings model.
ANTHROPIC_API_KEY=changeme

# --- Optional (defaults shown) ---

# Model tiers (A§8.5). Values are pydantic-ai model strings.
FITME_LLM_TIER_LARGE=anthropic:claude-opus-5
FITME_LLM_TIER_MEDIUM=anthropic:claude-sonnet-5
FITME_LLM_TIER_SMALL=anthropic:claude-haiku-4-5

# Per-agent override: a tier name (large/medium/small) or a full model string.
# FITME_LLM_AGENT_PLAN_GENERATE=large
# FITME_LLM_AGENT_PLAN_REVISE=large

FITME_WEB_HOST=127.0.0.1
FITME_WEB_PORT=8080
FITME_CHAT_RETENTION_DAYS=365
FITME_MAX_WEEKLY_INCREMENT_KG=2.5

# TOML price table for /system cost estimates. Unset means "cost unknown".
# FITME_PRICES_FILE=./prices.toml

# Allows a non-TLS base URL on localhost. Leave unset in production.
FITME_DEV=false

# Source repository link shown in the private-instance reply (A§6.1) and the web login page.
FITME_SOURCE_URL=https://github.com/vladimirbright/fitme
