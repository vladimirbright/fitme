# Copy to .env and fill in real values. Never commit .env.
# See docs/ARCHITECTURE.md §3.1 for what each variable does.
#
# Fitme itself only reads real environment variables (A§1): it does not load this file.
# Load it yourself:
#   - production (systemd): EnvironmentFile=/path/to/.env in the unit (see deploy/).
#   - dev: uv run --env-file .env fitme ...  (the Makefile's $(FITME) does this automatically
#     when a .env file is present in the repo root).

# --- Required ---

FITME_TELEGRAM_BOT_TOKEN=changeme
FITME_DB_PATH=./fitme.db
FITME_WEB_BASE_URL=https://fit.example.org
# At least 32 chars; the placeholder is deliberately too short so an unedited copy fails.
# Generate one: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
FITME_SECRET_KEY=changeme

# Read directly by pydantic-ai, not by fitme's own settings model.
ANTHROPIC_API_KEY=changeme

# --- Optional (defaults shown) ---

# Model tiers (A§8.5). Values are pydantic-ai model strings.
FITME_LLM_TIER_LARGE=anthropic:claude-opus-5
FITME_LLM_TIER_MEDIUM=anthropic:claude-sonnet-5
FITME_LLM_TIER_SMALL=anthropic:claude-haiku-4-5

# Per-agent override: a tier name (large/medium/small) or a full model string.
# FITME_LLM_AGENT_PLAN_GENERATE=large
# FITME_LLM_AGENT_PLAN_REVISE=large

# Local dev (`uv run fitme serve`) default. The Docker Compose deployment overrides this to
# 0.0.0.0 directly in compose.yaml (the container listens on all interfaces internally; the
# host-published port is still restricted to 127.0.0.1 — see compose.yaml) — no need to set
# it here for Docker.
FITME_WEB_HOST=127.0.0.1
FITME_WEB_PORT=8080
FITME_CHAT_RETENTION_DAYS=365
FITME_MAX_WEEKLY_INCREMENT_KG=2.5
# Send unprompted free text to the AI assistant (one LLM call per message). false = menu hint.
FITME_ASSISTANT_ENABLED=true

# The peer address(es)/CIDR uvicorn trusts to set X-Forwarded-* headers (M10). Only matters
# behind a reverse proxy. Default trusts only the loopback peer, which is what a direct,
# 127.0.0.1-published deployment sees (the Docker Compose default: no TLS profile — no proxy
# sits in front of `fitme`, so nothing should be trusted to set these headers). If you enable
# the optional `caddy` service (`docker compose --profile tls up -d`), set this to *exactly*
# Caddy's static address in compose.yaml (172.28.0.10), not the whole compose subnet: Docker
# NATs a request that comes in through `fitme`'s own host-published port through the bridge
# gateway (172.28.0.1), which is a different, still-in-subnet address — trusting the whole
# /24 would let that request forge X-Forwarded-* headers as convincingly as Caddy itself.
# FITME_FORWARDED_ALLOW_IPS=172.28.0.10
FITME_FORWARDED_ALLOW_IPS=127.0.0.1

# Public hostname for the optional `caddy` TLS-termination service (M10, `deploy/Caddyfile`).
# Caddy requests and renews its certificate for this host automatically; unused unless you
# run `docker compose --profile tls up -d`. Should match FITME_WEB_BASE_URL's host.
# FITME_DOMAIN=fit.example.org

# TOML price table for /system cost estimates. Unset means "cost unknown".
# FITME_PRICES_FILE=./prices.toml

# Allows a non-TLS base URL on localhost. Leave unset in production.
FITME_DEV=false

# Source repository link shown in the private-instance reply (A§6.1) and the web login page.
FITME_SOURCE_URL=https://github.com/vladimirbright/fitme

# `fitme serve` sets this itself; set it here too for any other way of running the process,
# so pydantic-ai never prints its promotional first-run banner (A§10).
PYDANTIC_AI_NO_BANNER=1
